{
  "name": "beesupport",
  "version": "0.1.4",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:db": "node --test --test-concurrency=1 tests/database/*.test.mjs",
    "uploads:cleanup": "tsx scripts/cleanup-uploads.ts",
    "ops:backup": "node scripts/recovery.mjs backup",
    "ops:verify": "node scripts/recovery.mjs verify",
    "ops:restore": "node scripts/recovery.mjs restore",
    "ops:release-check": "node scripts/release-check.mjs",
    "test:recovery": "node scripts/recovery-drill.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:browser": "node scripts/browser-suites.mjs",
    "e2e:ai-queue": "node scripts/ai-queue-e2e.mjs",
    "e2e:frontend": "node scripts/frontend-e2e.mjs",
    "e2e:features": "node scripts/features-e2e.mjs",
    "e2e:analytics-images": "node scripts/analytics-images-e2e.mjs",
    "test:analytics-images": "node --import tsx scripts/analytics-images-db.mjs",
    "smoke": "node scripts/smoke-admin-data.mjs",
    "wechat:bridge": "node scripts/wechatbot-bridge.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "service:install": "node scripts/install-service.mjs --install",
    "service:status": "systemctl --user status beesupport",
    "service:restart": "systemctl --user restart beesupport",
    "service:logs": "journalctl --user -u beesupport -n 100 --no-pager",
    "test:tenants": "node --import tsx scripts/tenants-db.mjs",
    "e2e:tenants": "node scripts/tenants-e2e.mjs",
    "test:subscriptions": "node --import tsx scripts/subscriptions-db.mjs",
    "e2e:subscriptions": "node scripts/subscriptions-e2e.mjs",
    "demo:seed": "node scripts/seed-hosted-demo.mjs",
    "e2e:demo-navigation": "node scripts/demo-navigation-e2e.mjs",
    "e2e:home-launchers": "node scripts/home-launchers-e2e.mjs",
    "test:growth": "node --import tsx scripts/growth-db.mjs",
    "e2e:growth": "node --import tsx scripts/growth-e2e.mjs",
    "test:collection": "node --import tsx scripts/collection-db.mjs",
    "e2e:collection": "node --import tsx scripts/collection-e2e.mjs",
    "test:operations": "node --import tsx scripts/operations-db.mjs",
    "e2e:operations": "node --import tsx scripts/operations-e2e.mjs",
    "test:accounts": "node --import tsx scripts/account-access-db.mjs",
    "e2e:accounts": "node --import tsx scripts/account-access-e2e.mjs",
    "test:deliveries": "node --import tsx scripts/deliveries-db.mjs",
    "e2e:deliveries": "cross-env E2E_DELIVERIES=true node --import tsx scripts/account-access-e2e.mjs",
    "test:reporting": "node --test tests/reporting.test.mjs",
    "e2e:reporting": "cross-env E2E_REPORTING=true node --import tsx scripts/account-access-e2e.mjs",
    "test:canned": "node --test tests/canned.test.mjs",
    "e2e:canned": "cross-env E2E_CANNED=true node --import tsx scripts/account-access-e2e.mjs",
    "test:follow-ups": "node --test tests/follow-ups.test.mjs",
    "e2e:follow-ups": "cross-env E2E_FOLLOWUPS=true node --import tsx scripts/account-access-e2e.mjs",
    "test:auto-follow-ups": "node --test tests/follow-up-rules.test.mjs",
    "e2e:auto-follow-ups": "cross-env E2E_AUTO_FOLLOWUPS=true node --import tsx scripts/account-access-e2e.mjs",
    "test:unanswered": "node --test tests/unanswered.test.mjs",
    "e2e:unanswered": "cross-env E2E_UNANSWERED=true node --import tsx scripts/account-access-e2e.mjs",
    "test:efficiency": "node --test tests/efficiency.test.mjs",
    "e2e:efficiency": "cross-env E2E_EFFICIENCY=true node --import tsx scripts/account-access-e2e.mjs",
    "eval:ai-quality": "node --import tsx scripts/ai-quality.mjs",
    "e2e:ai-policy": "node --import tsx scripts/ai-policy-browser-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@wechatbot/wechatbot": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "prisma": "^6.19.3",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.5"
  }
}
