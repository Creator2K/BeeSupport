# ---- 数据库 / Redis ----
# 默认值对应仓库根目录的 docker-compose.yml（宿主机端口用 5xxxx 避免与本地已有服务冲突）
DATABASE_URL="postgresql://beesupport:beesupport@localhost:55432/beesupport?schema=public"
REDIS_URL="redis://localhost:56379"
# docker compose 建库用的密码，必填（compose 不再提供默认值）。本地开发与 DATABASE_URL 里的密码保持一致；
# 生产环境必须改成强密码。密码会拼进容器内的 DATABASE_URL，只用字母和数字，或自行做 URL 编码。
# 已有数据卷时填原来的密码：这个变量只在首次建库时生效，不会修改已有库的密码。
POSTGRES_PASSWORD="beesupport"

# ---- 应用 ----
# 用于 JWT / 访客令牌签名，请务必改成随机值：openssl rand -base64 48
# 生产启动和生产构建会拒绝下面的示例值；Windows 也可用 Node 生成：
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="please-change-me-to-a-long-random-string"
# 访客端嵌入脚本、邮件里的链接都基于这个地址
APP_URL="http://localhost:3000"
PORT="3000"
# 后台“今日”指标使用的业务时区，与数据库或服务器系统时区无关
REPORT_TIMEZONE="Asia/Shanghai"

# 管理后台入口路径。
# 强烈建议改成一串随机路径，避免后台被扫描；留空或写 /admin 则使用默认值。
# 生成方式：node -e "console.log('/console-'+require('crypto').randomBytes(4).toString('hex'))"
ADMIN_PATH="/console-change-me"

# ---- 文件上传 ----
# 容器内默认 /app/data/uploads，本地开发默认 ./data/uploads
UPLOAD_DIR="./data/uploads"
# 单文件大小上限（字节），默认 20MB
UPLOAD_MAX_BYTES="20971520"
# 同时处理的上传请求数，默认 4。一次上传在内存里要占文件大小的数倍，内存小的机器可以调低。
# 同一账号 / 同一访客 IP 最多占一半；满了排队 10 秒，还没有名额就提示稍后再试
# UPLOAD_MAX_CONCURRENT="4"

# 数据保留天数，由每小时的维护任务删除更早的数据，删除后不可恢复；不设或设为 0 表示不清理。
# 依次是：风控拦截记录、操作审计、只浏览过且没有会话和资料的访客（会减少访客分析里的累计数字）。
# RISK_EVENT_RETENTION_DAYS="180"
# AUDIT_LOG_RETENTION_DAYS="365"
# ANONYMOUS_VISITOR_RETENTION_DAYS="365"

# ---- 发布与恢复（运维命令显式选择，不自动读取应用配置）----
# Compose 候选镜像应使用唯一标签，保留旧镜像 ID 供回退。
# APP_IMAGE="beesupport:20261026-<commit>"
# BACKUP_DIR="/srv/beesupport-backups"
# RECOVERY_DATABASE_URL 通过运维环境注入；恢复时必须指向新建空数据库。
# 说明与命令：docs/recovery-and-release.md

# ---- 邮件通知（也可以在后台「系统设置」里配置，后台配置优先）----
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="noreply@example.com"
# SMTP_PASS=""
# SMTP_FROM="BeeSupport <noreply@example.com>"

# ---- AI 助手（也可以在后台「AI 助手」里配置，后台配置优先）----
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"   # 开启知识库向量检索时用

# ---- 微信通知（后台「微信通知」扫码登录，凭证默认存 ${UPLOAD_DIR}/wechatbot）----
# WECHATBOT_ENABLED="true"            # 置 true 则服务启动时自动登录（等价于后台开关）
# WECHATBOT_STORAGE_DIR="./data/uploads/wechatbot"
# WECHATBOT_DEFAULT_TO=""             # 默认接收人（wxid 或备注名）

# ---- 微信通知外部桥接（可选，配合 scripts/wechatbot-bridge.mjs）----
# WECHATBOT_PORT="8787"
# WECHATBOT_HOST="127.0.0.1"    # 桥接服务监听地址，默认只接受本机请求；应用在别的机器或容器里时再改
# WECHATBOT_TOKEN=""            # 桥接服务必填，没有就拒绝启动；同一个值填进后台该渠道的「签名密钥」

# ---- 演示数据（pnpm db:seed 使用）----
# NODE_ENV=production 时不接受下面的默认演示密码，必须改成自己的，否则 seed 会报错退出
# SEED_ADMIN_EMAIL="admin@beesupport.local"
# SEED_ADMIN_PASSWORD="ChangeMe123!"
# SEED_AGENT_EMAIL="agent@beesupport.local"
# SEED_AGENT2_EMAIL="agent2@beesupport.local"
# SEED_AGENT_PASSWORD="ChangeMe123!"

# ---- 写入测试（必须使用独立测试库及连接该库的应用实例）----
# TEST_DATABASE_URL="postgresql://beesupport:beesupport@localhost:55432/beesupport_test?schema=public"
# TEST_APP_URL="http://localhost:3100"

# 监听地址独立于系统 / Docker 的 HOSTNAME
BIND_HOST="0.0.0.0"
# 仅 Docker Compose：应用端口发布到宿主机的地址和端口。默认只绑定本机，供同机反向代理访问；
# 要用服务器 IP 直接访问（例如内网部署）时改成 0.0.0.0。
# APP_BIND_ADDRESS="127.0.0.1"
# APP_PORT="3000"
# 仅在可信反向代理之后配置；逗号分隔的 IP / CIDR，默认不信任任何转发头
# TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"
# 实时连接只接受本站来源：页面来源等于 APP_URL，或与请求的 Host 一致。
# 反向代理改写了 Host 且还有其他访问域名时在这里补充，逗号分隔。
# SOCKET_ALLOWED_ORIGINS="https://support.example.com"

# ---- 实时连接缓存 ----
# 单个 Socket 连接内的身份与会话权限复核间隔（毫秒，默认 5000，最大 60000）。
# 主动撤销、停用、密码变更仍会立即断开对应 Socket。
# SOCKET_IDENTITY_TTL_MS="5000"
# SOCKET_CONVERSATION_TTL_MS="5000"
# 风控规则列表的缓存时间（毫秒），0 为不缓存
# RISK_RULE_CACHE_TTL_MS="5000"
